# ==========================================
# Dayloom Git Ignore Policy
# ==========================================

# Dependencies
node_modules/
web/node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
build/
web/dist/

# Environment configuration & Secret credentials
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example

# Service account keys and certificates
*.pem
*.key
*serviceAccountKey*.json
*service-account*.json
service-account-key.json
*firebase-adminsdk*.json

# Logs & debugging output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor directories and OS cache
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Test coverage & runner output
coverage/
.nyc_output/
