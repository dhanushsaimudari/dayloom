{
  "name": "dayloom",
  "version": "1.0.0",
  "description": "Dayloom - Your days are threads. Your life is the pattern. AI-powered personal reflection and progress intelligence platform.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev:backend": "node --watch --watch-path=src src/index.js",
    "dev:frontend": "cd web && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "cd web && npm run build",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "personal-growth",
    "journaling",
    "gemini",
    "firebase",
    "cloud-run"
  ],
  "author": "PGI Hackathon Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "latest",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
