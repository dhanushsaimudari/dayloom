# ==========================================
# Dayloom Frontend (Vite) Environment Variables
# ==========================================

# Firebase Web App Configuration (Obtained from Firebase Console for dayloom-personal-journal)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend API Base URL (Defaults to /api for proxied development and Cloud Run single-port deployment)
VITE_API_BASE_URL=/api

# Connect to Firebase Emulator Suite (Set to 'true' to use local Auth & Firestore emulators)
VITE_USE_FIREBASE_EMULATOR=false
