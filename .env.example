# ==========================================
# Dayloom Backend & Server Environment Variables
# ==========================================
PORT=5000
NODE_ENV=development

# Google Gemini API Key (Gemini 2.5 Flash)
GEMINI_API_KEY=

# Firebase Admin SDK Configuration (for dayloom-personal-journal)
# On Cloud Run / GCP, Default Application Credentials (ADC) are used automatically.
# For local server development with a Service Account:
FIREBASE_PROJECT_ID=dayloom-personal-journal
FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY should have escaped newlines: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=dayloom-personal-journal.appspot.com

# Firebase Local Emulator Suite (Set to 1 or true to use local emulators)
USE_FIREBASE_EMULATOR=0
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Allow mock auth tokens for automated unit tests (e.g. 'mock-testuser123')
ALLOW_MOCK_AUTH=false
